<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>The Blog | <%= blog.title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
    <link rel="stylesheet" href="/stylesheets/blog.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Sen:wght@400..800&display=swap"
          rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon.svg" type="image/x-icon">
</head>
<body>
<%- include('partials/header', {email}) %>

<%
    const formatDate = (d) => new Date(d).toLocaleDateString('en-US', {
        weekday: 'long', day: 'numeric', month: 'short', year: 'numeric'
    });
    const formatShortDate = (d) => new Date(d).toLocaleDateString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric'
    });
    const displayName = (user) => {
        if (!user) return 'Unknown';
        if (user.username && user.username.trim()) return user.username;
        return user.email ? user.email.split('@')[0] : 'Unknown';
    };
    const initial = (user) => displayName(user).charAt(0).toUpperCase();
    const readingTime = (text) => {
        const words = (text || '').trim().split(/\s+/).filter(Boolean).length;
        return Math.max(1, Math.round(words / 200));
    };
    const reactionCount = (reactions) => reactions ? reactions.length : 0;
    const hasReacted = (reactions) => !!(userId && reactions && reactions.some((r) => String(r.author) === userId));
    const isOwner = (author) => !!(userId && author && String(author._id) === userId);
    const isBlogAuthor = isOwner(blog.author);
%>

<div class="container blog-wrapper">
    <aside class="recent-posts">
        <h2>Recent blog posts</h2>
        <% recentBlogPosts.forEach((post, index) => { %>
            <article class="recent-post-card">
                <a href="/blogs/<%= post._id %>" class="recent-post-thumb">
                    <img src="<%= post.thumbnail || '/images/thumbnails/thumbnail-' + ((index % 5) + 1) + '.png' %>" alt="<%= post.title %>">
                </a>
                <p class="meta"><%= formatDate(post.date) %></p>
                <a class="recent-post-title" href="/blogs/<%= post._id %>">
                    <span><%= post.title %></span>
                    <img src="/images/arrow-icon.svg" alt="arrow icon">
                </a>
                <p class="recent-post-description"><%= post.description %></p>
            </article>
        <% }) %>
    </aside>

    <main class="blog-main">
        <article class="blog-article">
            <div class="meta">
                <a class="author-link" href="/users/<%= blog.author._id %>"><%= displayName(blog.author) %></a>
                • <span> <%= blog.date.getDate() %> </span>
                <span> <%= blog.date.toLocaleString('default', {month: 'short'}) %> </span>
                <span> <%= blog.date.getFullYear() %> </span>
                • <span><%= readingTime(blog.content) %> min read</span>
                • <span><%= blog.views %> view<%= blog.views === 1 ? '' : 's' %></span>
            </div>
            <h1 class="blog-article-title"><%= blog.title %></h1>
            <form class="bookmark-form" action="/blogs/<%= blog._id %>/bookmark" method="POST">
                <button type="submit" class="bookmark-btn <%= isBookmarked ? 'saved' : '' %>">
                    <%= isBookmarked ? '★ Saved' : '☆ Save for later' %>
                </button>
            </form>
            <% if (isBlogAuthor) { %>
                <div class="blog-owner-actions">
                    <a class="blog-edit" href="/blogs/<%= blog._id %>/edit">Edit post</a>
                    <form class="delete-blog-form" action="/blogs/<%= blog._id %>/delete" method="POST">
                        <button type="submit" class="blog-delete">Delete post</button>
                    </form>
                </div>
            <% } %>
            <div class="blog-article-content">
                <% blog.content.split(/\n+/).forEach((paragraph) => { %>
                    <% if (paragraph.trim()) { %>
                        <p><%= paragraph.trim() %></p>
                    <% } %>
                <% }) %>
            </div>
            <div class="blog-reactions" id="blog-reactions">
                <form class="reaction-form" action="/blogs/<%= blog._id %>/like" method="POST">
                    <button type="submit" class="reaction-btn <%= hasReacted(blog.likes) ? 'liked' : '' %>">
                        &#128077; <span><%= reactionCount(blog.likes) %></span>
                    </button>
                </form>
                <form class="reaction-form" action="/blogs/<%= blog._id %>/dislike" method="POST">
                    <button type="submit" class="reaction-btn <%= hasReacted(blog.dislikes) ? 'disliked' : '' %>">
                        &#128078; <span><%= reactionCount(blog.dislikes) %></span>
                    </button>
                </form>
            </div>
        </article>

        <section class="newsletter">
            <p class="newsletter-label">Newsletters</p>
            <h2 class="newsletter-title">Stories and interviews</h2>
            <p class="newsletter-subtitle">Subscribe to learn about new product features, the latest in technology, solutions, and updates.</p>
            <form class="newsletter-form" action="/newsletter" method="POST">
                <input type="email" name="email" placeholder="Enter your email" required>
                <button type="submit">Subscribe</button>
            </form>
            <p class="newsletter-note">We care about your data in our <a href="/">privacy policy</a></p>
        </section>

        <section class="comments" id="comments">
            <h2 class="comments-title">Comments</h2>

            <form class="comment-form" action="/blogs/<%= blog._id %>/comments" method="POST">
                <textarea name="content" placeholder="Add a comment..." required></textarea>
                <button type="submit">Post Comment</button>
            </form>

            <div class="comment-list">
                <% if (!blog.comments || blog.comments.length === 0) { %>
                    <p class="no-comments">No comments yet. Be the first to share your thoughts.</p>
                <% } else { %>
                    <% blog.comments.forEach((comment) => { %>
                        <div class="comment" id="comment-<%= comment._id %>">
                            <div class="comment-avatar"><%= initial(comment.author) %></div>
                            <div class="comment-body">
                                <div class="comment-head">
                                    <div>
                                        <p class="comment-author">
                                            <% if (comment.author) { %>
                                                <a class="author-link" href="/users/<%= comment.author._id %>"><%= displayName(comment.author) %></a>
                                            <% } else { %>
                                                <%= displayName(comment.author) %>
                                            <% } %>
                                        </p>
                                        <p class="comment-date">
                                            <%= formatShortDate(comment.date) %>
                                            <% if (comment.editedAt) { %>
                                                <span class="comment-edited">· edited (<%= formatShortDate(comment.editedAt) %>)</span>
                                            <% } %>
                                        </p>
                                    </div>
                                    <div class="reactions">
                                        <form class="reaction-form" action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/like" method="POST">
                                            <button type="submit" class="reaction-btn <%= hasReacted(comment.likes) ? 'liked' : '' %>">
                                                &#128077; <span><%= reactionCount(comment.likes) %></span>
                                            </button>
                                        </form>
                                        <form class="reaction-form" action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/dislike" method="POST">
                                            <button type="submit" class="reaction-btn <%= hasReacted(comment.dislikes) ? 'disliked' : '' %>">
                                                &#128078; <span><%= reactionCount(comment.dislikes) %></span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <p class="comment-content" id="content-<%= comment._id %>"><%= comment.content %></p>

                                <% if (isOwner(comment.author)) { %>
                                    <form class="edit-form" id="edit-form-<%= comment._id %>"
                                          action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/edit" method="POST">
                                        <textarea name="content" required><%= comment.content %></textarea>
                                        <div class="edit-form-actions">
                                            <button type="submit" class="edit-submit">Save</button>
                                            <button type="button" class="edit-cancel" data-comment-id="<%= comment._id %>">Cancel</button>
                                        </div>
                                    </form>
                                <% } %>

                                <div class="comment-actions">
                                    <button type="button" class="comment-reply" data-comment-id="<%= comment._id %>">Reply</button>
                                    <% if (isOwner(comment.author)) { %>
                                        <button type="button" class="comment-edit" data-comment-id="<%= comment._id %>">Edit</button>
                                    <% } %>
                                    <% if (isOwner(comment.author) || isBlogAuthor) { %>
                                        <form class="delete-form" action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/delete" method="POST">
                                            <button type="submit" class="comment-delete">Delete</button>
                                        </form>
                                    <% } %>
                                </div>

                                <form class="reply-form" id="reply-form-<%= comment._id %>"
                                      action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/replies" method="POST">
                                    <textarea name="content" placeholder="Write a reply..." required></textarea>
                                    <div class="reply-form-actions">
                                        <button type="submit" class="reply-submit">Reply</button>
                                        <button type="button" class="reply-cancel" data-comment-id="<%= comment._id %>">Cancel</button>
                                    </div>
                                </form>

                                <% if (comment.replies && comment.replies.length > 0) { %>
                                    <div class="reply-list">
                                        <% comment.replies.forEach((reply) => { %>
                                            <div class="comment reply">
                                                <div class="comment-avatar"><%= initial(reply.author) %></div>
                                                <div class="comment-body">
                                                    <div class="comment-head">
                                                        <div>
                                                            <p class="comment-author">
                                                                <% if (reply.author) { %>
                                                                    <a class="author-link" href="/users/<%= reply.author._id %>"><%= displayName(reply.author) %></a>
                                                                <% } else { %>
                                                                    <%= displayName(reply.author) %>
                                                                <% } %>
                                                            </p>
                                                            <p class="comment-date"><%= formatShortDate(reply.date) %></p>
                                                        </div>
                                                        <div class="reactions">
                                                            <form class="reaction-form" action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/replies/<%= reply._id %>/like" method="POST">
                                                                <button type="submit" class="reaction-btn <%= hasReacted(reply.likes) ? 'liked' : '' %>">
                                                                    &#128077; <span><%= reactionCount(reply.likes) %></span>
                                                                </button>
                                                            </form>
                                                            <form class="reaction-form" action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/replies/<%= reply._id %>/dislike" method="POST">
                                                                <button type="submit" class="reaction-btn <%= hasReacted(reply.dislikes) ? 'disliked' : '' %>">
                                                                    &#128078; <span><%= reactionCount(reply.dislikes) %></span>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                    <p class="comment-content"><%= reply.content %></p>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>
    </main>
</div>

<%- include('partials/footer'); %>

<script src="/javascripts/blog.js"></script>

</body>
</html>
