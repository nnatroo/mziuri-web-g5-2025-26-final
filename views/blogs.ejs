<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>The Blog | Blogs</title>
    <link rel="stylesheet" href="./stylesheets/style.css">
    <link rel="stylesheet" href="./stylesheets/header.css">
    <link rel="stylesheet" href="./stylesheets/footer.css">
    <link rel="stylesheet" href="./stylesheets/blogs.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Sen:wght@400..800&display=swap"
          rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon.svg" type="image/x-icon">
</head>
<body>
<%- include('partials/header', {email}) %>

<div class="container blogs-wrapper">

    <h1 class="title">THE BLOG</h1>

    <%
        // Build a /blogs URL from the current filters, applying any overrides.
        const buildQuery = (o) => {
            const p = {q: search, tag: tag, sort: (sort && sort !== 'newest') ? sort : '', page: ''};
            Object.assign(p, o);
            const parts = [];
            if (p.page) parts.push('page=' + p.page);
            if (p.q) parts.push('q=' + encodeURIComponent(p.q));
            if (p.tag) parts.push('tag=' + encodeURIComponent(p.tag));
            if (p.sort) parts.push('sort=' + p.sort);
            return '/blogs' + (parts.length ? '?' + parts.join('&') : '');
        };
        const pageHref = (n) => buildQuery({page: n});
        const sortHref = (s) => buildQuery({sort: (s === 'newest' ? '' : s), page: ''});
        const tagHref = (t) => buildQuery({tag: t, page: ''});
    %>

    <form class="blog-search" action="/blogs" method="GET" role="search">
        <input type="search" name="q" value="<%= search %>"
               placeholder="Search posts by title or description...">
        <input type="hidden" name="sort" value="<%= sort %>">
        <input type="hidden" name="tag" value="<%= tag %>">
        <button type="submit">Search</button>
        <% if (search) { %>
            <a class="blog-search-clear" href="<%= buildQuery({q: ''}) %>">Clear</a>
        <% } %>
    </form>

    <% if (page === 1 && !search && !tag && sort === 'newest') { %>
    <section class="blogs-swiper-wrapper">
        <div class="swiper blogs-swiper">
            <div class="swiper-wrapper">
                <% blogs.forEach((blog) => { %>
                    <div class="swiper-slide">
                        <a href="/blogs/<%= blog._id %>" class="swiper-blog-card">
                            <figure>
                                <img src="<%= blog.thumbnail || '/images/thumbnails/thumbnail-1.png' %>" alt="<%= blog.title %>">
                            </figure>
                            <p class="meta"><%= blog.author.email %>
                                • <%= blog.date.getDate() %> <%= blog.date.toLocaleString('default', {month: 'short'}) %> <%= blog.date.getFullYear() %></p>
                            <h3><%= blog.title %></h3>
                            <p class="description"><%= blog.description %></p>
                        </a>
                    </div>
                <% }) %>
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    </section>
    <% } %>

    <% if (page === 1 && !search && !tag && sort === 'newest' && blogs.length >= 4) { %>
    <section class="recent-blogs-wrapper">
        <h2>Recent blog posts</h2>

        <div class="row-1">
            <div class="left-column">
                <figure>
                    <img src="<%= blogs[0].thumbnail || '/images/thumbnails/thumbnail-1.png' %>" alt="<%= blogs[0].title %>">
                </figure>
                <div class="meta-info-wrapper">
                    <span><%= blogs[0].author.email %></span> • <span> <%= blogs[0].date.getDate() %> </span>
                    <span> <%= blogs[0].date.toLocaleString('default', {month: 'short'}) %> </span>
                    <span> <%= blogs[0].date.getFullYear() %> </span>
                </div>
                <figure class="title-wrapper">
                    <a href="/blogs/<%= blogs[0]._id %>"><%= blogs[0].title %></a>
                    <img src="/images/arrow-icon.svg" alt="arrow-icon">
                </figure>
                <div class="description-wrapper">
                    <p><%= blogs[0].description %></p>
                </div>
            </div>

            <div class="right-column">
                <div class="md-blog-card">
                    <figure>
                        <img src="<%= blogs[1].thumbnail || '/images/thumbnails/thumbnail-2.png' %>" alt="<%= blogs[1].title %>">
                    </figure>
                    <div>
                        <div class="meta-info-wrapper">
                            <span><%= blogs[1].author.email %></span> • <span> <%= blogs[1].date.getDate() %> </span>
                            <span> <%= blogs[1].date.toLocaleString('default', {month: 'short'}) %> </span>
                            <span> <%= blogs[1].date.getFullYear() %> </span>
                        </div>
                        <figure class="title-wrapper">
                            <a href="/blogs/<%= blogs[1]._id %>"><%= blogs[1].title %></a>
                        </figure>
                        <div class="description-wrapper">
                            <p><%= blogs[1].description %></p>
                        </div>
                    </div>
                </div>
                <div class="md-blog-card">
                    <figure>
                        <img src="<%= blogs[2].thumbnail || '/images/thumbnails/thumbnail-3.png' %>" alt="<%= blogs[2].title %>">
                    </figure>
                    <div>
                        <div class="meta-info-wrapper">
                            <span><%= blogs[2].author.email %></span> • <span> <%= blogs[2].date.getDate() %> </span>
                            <span> <%= blogs[2].date.toLocaleString('default', {month: 'short'}) %> </span>
                            <span> <%= blogs[2].date.getFullYear() %> </span>
                        </div>
                        <figure class="title-wrapper">
                            <a href="/blogs/<%= blogs[2]._id %>"><%= blogs[2].title %></a>
                        </figure>
                        <div class="description-wrapper">
                            <p><%= blogs[2].description %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row-2">
            <figure>
                <img src="<%= blogs[3].thumbnail || '/images/thumbnails/thumbnail-4.png' %>" alt="<%= blogs[3].title %>">
            </figure>
            <div class="content">
                <div>
                    <p class="meta"><%= blogs[3].author.email %>
                        • <%= blogs[3].date.getDate() %> <%= blogs[3].date.toLocaleString('default', {month: 'short'}) %> <%= blogs[3].date.getFullYear() %></p>
                </div>
                <a class="blog-title-wrapper" href="/blogs/<%= blogs[3]._id %>">
                    <p><%= blogs[3].title %></p>
                    <img src="/images/arrow-icon.svg" alt="arrow-icon">
                </a>
                <div>
                    <p class="description"><%= blogs[3].description %></p>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <section class="all-blogs-posts-wrapper">
        <div class="all-blogs-head">
            <div class="all-blogs-heading">
                <% if (search || tag) { %>
                    <h4><% if (search) { %>Results for “<%= search %>”<% } else { %>Posts<% } %><% if (tag) { %> tagged “<%= tag %>”<% } %> (<%= totalBlogs %>)</h4>
                    <a class="filter-clear" href="/blogs">Clear filters</a>
                <% } else { %>
                    <h4>All blog posts</h4>
                <% } %>
            </div>

            <div class="sort-tabs">
                <a class="sort-tab <%= sort === 'newest' ? 'active' : '' %>" href="<%= sortHref('newest') %>">Newest</a>
                <a class="sort-tab <%= sort === 'most-liked' ? 'active' : '' %>" href="<%= sortHref('most-liked') %>">Most liked</a>
                <a class="sort-tab <%= sort === 'most-commented' ? 'active' : '' %>" href="<%= sortHref('most-commented') %>">Most commented</a>
            </div>
        </div>

        <% if (blogs.length === 0) { %>
            <p class="no-results">
                No posts found<% if (search) { %> for “<%= search %>”<% } %><% if (tag) { %> tagged “<%= tag %>”<% } %>.
            </p>
        <% } else { %>
            <div class="blogs-grid">
                <% blogs.forEach((blog) => {%>
                    <div class="blog-card">
                        <figure>
                            <img src="<%= blog.thumbnail || '/images/thumbnails/thumbnail-5.png' %>" alt="<%= blog.title %>">
                        </figure>
                        <div>
                            <p class="meta"><%= blog.author.email %>> • <%= blog.date.getDate() %> <%= blog.date.toLocaleString('default', {month: 'short'}) %> <%= blog.date.getFullYear() %></p>
                        </div>
                        <a href="/blogs/<%= blog._id %>">
                            <span><%= blog.title %></span>
                            <img src="/images/arrow-icon.svg" alt="Arrow icon">
                        </a>
                        <p class="description"><%= blog.description %></p>
                        <% if (blog.tags && blog.tags.length) { %>
                            <div class="card-tags">
                                <% blog.tags.forEach((t) => { %>
                                    <a class="tag-chip" href="<%= tagHref(t) %>"><%= t %></a>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>

            <% if (totalPages > 1) { %>
                <nav class="pagination" aria-label="Blog pages">
                    <% if (page > 1) { %>
                        <a class="pagination-arrow" href="<%= pageHref(page - 1) %>">Previous</a>
                    <% } else { %>
                        <span class="pagination-arrow disabled">Previous</span>
                    <% } %>

                    <% for (let p = 1; p <= totalPages; p++) { %>
                        <% if (p === page) { %>
                            <span class="pagination-page active"><%= p %></span>
                        <% } else { %>
                            <a class="pagination-page" href="<%= pageHref(p) %>"><%= p %></a>
                        <% } %>
                    <% } %>

                    <% if (page < totalPages) { %>
                        <a class="pagination-arrow" href="<%= pageHref(page + 1) %>">Next</a>
                    <% } else { %>
                        <span class="pagination-arrow disabled">Next</span>
                    <% } %>
                </nav>
            <% } %>
        <% } %>
    </section>
</div>

<%- include('partials/footer'); %>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="/javascripts/blogs.js"></script>
</body>
</html>
